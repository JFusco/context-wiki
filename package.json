{
  "name": "context-wiki",
  "version": "0.0.0",
  "private": true,
  "description": "A cross-agent skill for durable repository context wikis and Sigma.js graphs.",
  "type": "commonjs",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "test": "node scripts/test.cjs",
    "test:unit": "node scripts/unit.test.cjs",
    "validate": "node scripts/validate-install.cjs && node scripts/test.cjs && node scripts/wiki/check.cjs",
    "graph:build": "node scripts/wiki/build-graph.cjs",
    "graph:view": "node scripts/wiki/serve-graph.cjs",
    "wiki:check": "node scripts/wiki/check.cjs",
    "prepare": "husky",
    "commit": "ai-commit run",
    "pr:create": "ai-pr"
  },
  "dependencies": {
    "graphology": "0.26.0",
    "sigma": "3.0.3"
  },
  "devDependencies": {
    "@verndale/ai-commit": "2.7.0",
    "@verndale/ai-pr": "1.3.5",
    "husky": "^9.1.7",
    "dotenv": "^16.4.7"
  }
}
